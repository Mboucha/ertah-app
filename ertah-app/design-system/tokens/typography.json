{
  "font": {
    "family": {
      "primary": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Sans Arabic",
          "sans-serif"
        ],
        "$description": "Figma variable font-family/primary. Mode Arabic (default) = IBM Plex Sans Arabic; mode English = Inter.",
        "$extensions": {
          "ertah.modes": {
            "Arabic": [
              "IBM Plex Sans Arabic",
              "sans-serif"
            ],
            "English": [
              "Inter",
              "IBM Plex Sans Arabic",
              "sans-serif"
            ]
          }
        }
      },
      "english": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "IBM Plex Sans Arabic",
          "sans-serif"
        ],
        "$description": "Figma variable font-family/primary, mode English. IBM Plex Sans Arabic is the fallback for Arabic strings kept on English screens."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$description": "Figma text style \"Display/34 Bold\"",
      "$value": {
        "fontFamily": "{font.family.primary}",
        "fontSize": {
          "value": 34,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0,
